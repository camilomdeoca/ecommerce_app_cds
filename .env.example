# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=ecommerce_cds

DATABASE_URL=postgresql://user:password@postgres:5432/ecommerce_cds

# SeaweedFS / S3
AWS_ACCESS_KEY_ID=ecommerce_cds
AWS_SECRET_ACCESS_KEY=ecommerce_cds-dev
SEAWEED_S3_PORT=8333
SEAWEED_FILER_PORT=8888
SEAWEED_MASTER_PORT=9333
STORAGE_PUBLIC_URL=http://localhost:8333

STORAGE_REGION=us-east-1
STORAGE_BUCKET=ecommerce_cds-media
STORAGE_ACCESS_KEY=access-key

# Backend
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret

