# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=ecommerce_cds

DATABASE_URL=postgresql://user:password@postgres:5432/ecommerce_cds

# SeaweedFS / S3
AWS_ACCESS_KEY_ID=ecommerce_cds
AWS_SECRET_ACCESS_KEY=ecommerce_cds-dev
SEAWEED_S3_PORT=8333
SEAWEED_FILER_PORT=8888
SEAWEED_MASTER_PORT=9333
S3_PUBLIC_URL=http://localhost:8333

S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY=access-key

# Backend
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret

# Frontend
WEB_PORT=3000
API_URL=http://localhost:3001
