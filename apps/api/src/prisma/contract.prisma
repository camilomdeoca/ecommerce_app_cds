// use prisma-8

enum UserRole {
  @@type("pg/text@1")
  customer = "customer"
  admin    = "admin"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(customer)
}

model Product {
  id          BigInt @id @default(autoincrement())
  name        String
  priceCents  Int
  description String
}
