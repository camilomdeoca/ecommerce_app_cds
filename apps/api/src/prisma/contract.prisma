// use prisma-8

enum UserRole {
  @@type("pg/text@1")
  customer = "customer"
  admin    = "admin"
}

enum OrderStatus {
  @@type("pg/text@1")
  pending = "pending"
  paid    = "paid"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(customer)
  orders       Order[]
}

model Product {
  id          BigInt  @id @default(autoincrement())
  name        String
  priceCents  Int
  description String
  active      Boolean @default(true)
}

model CartItem {
  id        Int    @id @default(autoincrement())
  userId    Int
  productId BigInt
  quantity  Int    @default(1)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int
  status          OrderStatus @default(pending)
  totalCents      Int
  stripeSessionId String?     @unique
  createdAt       TimestamptzString(3) @default(now())
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@index([userId])
}

model OrderItem {
  id         Int    @id @default(autoincrement())
  orderId    Int
  productId  BigInt
  name       String
  priceCents Int
  quantity   Int
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
